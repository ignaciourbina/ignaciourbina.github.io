{
  "2-derivatives": {
    "title": "Worked exercises: rules of differentiation",
    "source": "From the Exercise slide (p. 20), applying the rules on p. 19.",
    "description": "The seven problems from the lecture, each solved one step at a time. Try the problem on paper first, then reveal the steps.",
    "exercises": [
      {
        "id": "x-squared",
        "prompt": "\\frac{d}{dx}\\,x^2",
        "rule": "Power rule",
        "steps": [
          {
            "math": "\\frac{d}{dx}\\,x^n = n\\,x^{n-1}",
            "note": "The power rule, with n = 2."
          },
          {
            "math": "\\frac{d}{dx}\\,x^2 = 2\\,x^{2-1}",
            "note": "Bring the exponent down as a factor, then subtract one from it."
          },
          {
            "math": "= 2x",
            "note": "The slope of the parabola at any point x."
          }
        ]
      },
      {
        "id": "three-x-cubed",
        "prompt": "\\frac{d}{dx}\\,3x^3",
        "rule": "Constant multiple + power rule",
        "steps": [
          {
            "math": "[k\\,f(x)]' = k\\,f'(x)",
            "note": "Constants ride along untouched."
          },
          {
            "math": "\\frac{d}{dx}\\,3x^3 = 3\\cdot\\frac{d}{dx}\\,x^3 = 3\\cdot 3x^2",
            "note": "Apply the power rule inside, with n = 3."
          },
          {
            "math": "= 9x^2",
            "note": null
          }
        ]
      },
      {
        "id": "x",
        "prompt": "\\frac{d}{dx}\\,x",
        "rule": "Power rule",
        "steps": [
          {
            "math": "x = x^1",
            "note": "Rewrite so the power rule applies."
          },
          {
            "math": "\\frac{d}{dx}\\,x^1 = 1\\cdot x^0 = 1\\cdot 1",
            "note": "Any nonzero number to the power 0 is 1."
          },
          {
            "math": "= 1",
            "note": "A line with slope 1 everywhere — which is what y = x is."
          }
        ]
      },
      {
        "id": "constant",
        "prompt": "\\frac{d}{dx}\\,5",
        "rule": "Constant",
        "steps": [
          {
            "math": "y = 5",
            "note": "A horizontal line: a constant does not change as x changes."
          },
          {
            "math": "= 0",
            "note": "No change means zero rate of change. The derivative of any constant is 0."
          }
        ]
      },
      {
        "id": "sqrt-x",
        "prompt": "\\frac{d}{dx}\\,\\sqrt{x}",
        "rule": "Power rule, fractional exponent",
        "steps": [
          {
            "math": "\\sqrt{x} = x^{1/2}",
            "note": "Rewrite the root as a power so the power rule applies."
          },
          {
            "math": "\\frac{d}{dx}\\,x^{1/2} = \\tfrac{1}{2}\\,x^{1/2 - 1} = \\tfrac{1}{2}\\,x^{-1/2}",
            "note": "Same rule as before — n need not be a whole number."
          },
          {
            "math": "= \\frac{1}{2\\sqrt{x}}",
            "note": "A negative exponent is a reciprocal: x^(−1/2) = 1/√x."
          }
        ]
      },
      {
        "id": "sum",
        "prompt": "\\frac{d}{dx}\\,(3x^4 + 3x)",
        "rule": "Sum rule",
        "steps": [
          {
            "math": "[f(x) + g(x)]' = f'(x) + g'(x)",
            "note": "The derivative is a linear operator: differentiate term by term."
          },
          {
            "math": "\\frac{d}{dx}\\,3x^4 + \\frac{d}{dx}\\,3x = 12x^3 + 3",
            "note": "Power rule on each term, constants riding along."
          },
          {
            "math": "= 12x^3 + 3",
            "note": null
          }
        ]
      },
      {
        "id": "product",
        "prompt": "\\frac{d}{dx}\\,(3x^2 - 3)(4x^3 - 2x)",
        "rule": "Product rule",
        "steps": [
          {
            "math": "[f(x)\\,g(x)]' = f'(x)\\,g(x) + f(x)\\,g'(x)",
            "note": "Not the product of the derivatives — each factor takes its turn being differentiated."
          },
          {
            "math": "f(x) = 3x^2 - 3 \\;\\Rightarrow\\; f'(x) = 6x",
            "note": "Differentiate the first factor."
          },
          {
            "math": "g(x) = 4x^3 - 2x \\;\\Rightarrow\\; g'(x) = 12x^2 - 2",
            "note": "Differentiate the second factor."
          },
          {
            "math": "= 6x\\,(4x^3 - 2x) + (3x^2 - 3)(12x^2 - 2)",
            "note": "Substitute all four pieces into the rule."
          },
          {
            "math": "= 24x^4 - 12x^2 + 36x^4 - 42x^2 + 6",
            "note": "Expand both products."
          },
          {
            "math": "= 60x^4 - 54x^2 + 6",
            "note": "Check: expanding first gives 12x⁵ − 18x³ + 6x, whose derivative is the same."
          }
        ]
      }
    ]
  }
}
